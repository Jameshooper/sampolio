# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

/data

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-prod/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated theme files (copied from node_modules) — glass-overrides.css is
# hand-authored (not generated by scripts/copy-themes.mjs) and stays committed.
# (A trailing-slash /public/themes/ would exclude the whole dir and git can't
# re-include a file inside an excluded dir, hence the /* + negation form.)
/public/themes/*
!/public/themes/glass-overrides.css

# Distribution
/dist/

# Personal data (reference spreadsheets, exported ledgers, etc.)
*.numbers
*.csv

# Local-only tests that assert against the maintainer's real financial records.
# The committed suites use synthetic fixtures; these keep the real-data parity
# check available locally without shipping the figures. Vitest's default glob
# still picks them up.
*.local.test.ts

# Shared skills live in .agents/skills; only their Claude aliases are tracked here.
/.claude/skills/*
!/.claude/skills/deploy-prod/
!/.claude/skills/verify-documentation/
/.claude/skills/deploy-prod/*
/.claude/skills/verify-documentation/*
!/.claude/skills/deploy-prod/SKILL.md
!/.claude/skills/verify-documentation/SKILL.md

# Machine-local permissions and working notes
/.claude/settings.local.json
/plans/
